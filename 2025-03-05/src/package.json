{
  "name": "nodejs-paris",
  "event": {
    "name": "Node.js Paris",
    "url": "http://nodejs.paris/meetups",
    "location": {
      "city": "Paris",
      "country": "France",
      "latitude": 48.86860314335723,
      "longitude": 2.3354337719970117
    }
  },
  "private": true,
  "description": "Prenez du recul sur les nouvelles API Node.js, de --watch et node:test à parseArgs, .env et SQLite, pour adopter les outils dont vos projets ont réellement besoin.",
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /2025-03-05/nodejs-paris/ --out ../../dist/2025-03-05/nodejs-paris",
    "export": "slidev export --per-slide --output ../2025-03-05-nodejs-paris.pdf",
    "thumbnail:cp": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail.png",
    "thumbnail": "slidev export --per-slide --range 1 --format png",
    "thumbnail:dark": "slidev export --per-slide --range 1 --dark --format png",
    "thumbnail:cp:dark": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail-dark.png",
    "optimize:thumbnails": "optipng -o2 -quiet ./public/thumbnail*.png"
  },
  "dependencies": {
    "reka-ui": "catalog:ui",
    "slidev-addon-inalia": "catalog:slidev",
    "slidev-theme-personal": "workspace:*"
  },
  "devDependencies": {
    "@slidev/cli": "catalog:build",
    "vite": "catalog:build"
  }
}
