{
  "name": "paris-typescript",
  "event": {
    "name": "Paris TypeScript",
    "url": "https://typescript.paris/",
    "location": {
      "city": "Paris",
      "country": "France",
      "latitude": 48.87169321094806,
      "longitude": 2.304536999998755
    }
  },
  "private": true,
  "description": "Analysez le coût des dépendances JavaScript superflues et apprenez à réduire l'empreinte des packages, du bundle et de la chaîne de production.",
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /2025-12-09/paris-typescript/ --out ../../dist/2025-12-09/paris-typescript",
    "export": "slidev export --per-slide --output ../2025-12-09-paris-typescript.pdf",
    "thumbnail:cp": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail.png",
    "thumbnail": "slidev export --per-slide --range 1 --format png",
    "thumbnail:dark": "slidev export --per-slide --range 1 --dark --format png",
    "thumbnail:cp:dark": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail-dark.png",
    "optimize:thumbnails": "optipng -o2 -quiet ./public/thumbnail*.png"
  },
  "dependencies": {
    "reka-ui": "catalog:ui",
    "slidev-addon-inalia": "catalog:slidev",
    "slidev-theme-personal": "workspace:*"
  },
  "devDependencies": {
    "@slidev/cli": "catalog:build",
    "vite": "catalog:build"
  }
}
