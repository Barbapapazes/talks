{
  "name": "devlille",
  "type": "module",
  "event": {
    "name": "DevLille",
    "url": "https://devlille.fr/",
    "location": {
      "city": "Lille",
      "country": "France",
      "latitude": 50.632820223594464,
      "longitude": 3.0780877271604523
    }
  },
  "recording": "https://youtu.be/AwhemfKsd8k",
  "private": true,
  "description": "Plongée au cœur de la pipeline de Vite : découvrez son fonctionnement interne et comment prendre le contrôle avec des plugins personnalisés.",
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /2026-06-12/devlille/ --out ../../dist/2026-06-12/devlille",
    "export": "slidev export --per-slide --timeout 240000 --output ../2026-06-12-devlille.pdf",
    "thumbnail:cp": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail.png",
    "thumbnail": "slidev export --per-slide --range 1 --format png",
    "thumbnail:dark": "slidev export --per-slide --range 1 --dark --format png",
    "thumbnail:cp:dark": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail-dark.png",
    "optimize:thumbnails": "optipng -o2 -quiet ./public/thumbnail*.png"
  },
  "dependencies": {
    "@dagrejs/dagre": "catalog:ui",
    "@shikijs/langs": "catalog:ui",
    "@shikijs/themes": "catalog:ui",
    "@shikijs/transformers": "catalog:ui",
    "@slidev/client": "catalog:slidev",
    "@tsparticles/engine": "catalog:ui",
    "@tsparticles/plugin-emitters": "catalog:ui",
    "@tsparticles/slim": "catalog:ui",
    "@unovis/ts": "catalog:ui",
    "@unovis/vue": "catalog:ui",
    "@vue-flow/background": "catalog:ui",
    "@vue-flow/core": "catalog:ui",
    "@vueuse/core": "catalog:ui",
    "@vueuse/shared": "catalog:ui",
    "reka-ui": "catalog:ui",
    "shiki": "catalog:ui",
    "slidev-addon-inalia": "catalog:slidev",
    "slidev-theme-personal": "workspace:*",
    "tailwind-variants": "catalog:ui",
    "vue-demi": "catalog:ui"
  },
  "devDependencies": {
    "@slidev/cli": "catalog:build",
    "@vue/tsconfig": "catalog:build",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-info": "catalog:vite-talk",
    "vite-plugin-inspect": "catalog:vite-talk",
    "vite-plugin-run": "catalog:vite-talk"
  }
}
