{
  "name": "strasbourgjs",
  "event": {
    "name": "StrasbourgJS",
    "url": "https://strasbourgjs.org/",
    "location": {
      "city": "Strasbourg",
      "country": "France",
      "latitude": 48.60359333922045,
      "longitude": 7.756997318155868
    }
  },
  "private": true,
  "description": "Explorez UnJS, son écosystème de bibliothèques TypeScript universelles et les outils qui simplifient la création de packages npm compatibles avec tous les runtimes.",
  "recording": "https://youtu.be/mPcJXqaBLFM",
  "article": "https://soubiran.dev/posts/my-first-meetup-talk-a-dive-into-the-large-unjs-ecosystem",
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /2024-04-12/strasbourgjs/ --out ../../dist/2024-04-12/strasbourgjs",
    "export": "slidev export --per-slide --output ../2024-04-12-strasbourgjs.pdf",
    "thumbnail:cp": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail.png",
    "thumbnail": "slidev export --per-slide --range 1 --format png",
    "thumbnail:dark": "slidev export --per-slide --range 1 --dark --format png",
    "thumbnail:cp:dark": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail-dark.png",
    "optimize:thumbnails": "optipng -o2 -quiet ./public/thumbnail*.png"
  },
  "dependencies": {
    "@formkit/auto-animate": "catalog:ui",
    "@slidev/client": "catalog:slidev",
    "seedrandom": "catalog:ui",
    "slidev-addon-inalia": "catalog:slidev"
  },
  "devDependencies": {
    "@slidev/cli": "catalog:build",
    "unocss": "catalog:build",
    "vite": "catalog:build"
  }
}
