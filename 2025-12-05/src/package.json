{
  "name": "devfest-dijon",
  "event": {
    "name": "DevFest Dijon",
    "url": "https://devfest.developers-group-dijon.fr/",
    "location": {
      "city": "Dijon",
      "country": "France",
      "latitude": 47.31307384050383,
      "longitude": 5.072856389593075
    }
  },
  "private": true,
  "description": "Décortiquez les mécanismes de réactivité du frontend : propagation des changements, suivi des dépendances, signaux, computed values et effects derrière les frameworks modernes.",
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /2025-12-05/devfest-dijon/ --out ../../dist/2025-12-05/devfest-dijon",
    "export": "slidev export --per-slide --output ../2025-12-05-devfest-dijon.pdf",
    "thumbnail:cp": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail.png",
    "thumbnail": "slidev export --per-slide --range 1 --format png",
    "thumbnail:dark": "slidev export --per-slide --range 1 --dark --format png",
    "thumbnail:cp:dark": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail-dark.png",
    "optimize:thumbnails": "optipng -o2 -quiet ./public/thumbnail*.png"
  },
  "dependencies": {
    "reka-ui": "catalog:ui",
    "slidev-addon-graph": "catalog:slidev",
    "slidev-addon-inalia": "catalog:slidev",
    "slidev-theme-personal": "workspace:*"
  },
  "devDependencies": {
    "@slidev/cli": "catalog:build",
    "alien-signals": "catalog:ui",
    "vite": "catalog:build"
  }
}
