{
  "name": "mixit",
  "type": "module",
  "event": {
    "name": "MiXiT",
    "url": "https://mixitconf.org/",
    "location": {
      "city": "Lyon",
      "country": "France",
      "latitude": 45.78405605635917,
      "longitude": 4.869033628453851
    }
  },
  "recording": "https://youtu.be/wL8EbLLGaVo",
  "private": true,
  "description": "Examinez comment l'IA redéfinit le métier de développeur, les compétences à entretenir et les façons de rester acteur de son évolution professionnelle face à l'automatisation.",
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /2026-04-17/mixit/ --out ../../dist/2026-04-17/mixit",
    "export": "echo \"No export for this talk as Google Slides is used\" && exit 0",
    "thumbnail:cp": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail.png",
    "thumbnail": "slidev export --per-slide --range 1 --format png",
    "thumbnail:dark": "slidev export --per-slide --range 1 --dark --format png",
    "thumbnail:cp:dark": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail-dark.png",
    "optimize:thumbnails": "optipng -o2 -quiet ./public/thumbnail*.png"
  },
  "dependencies": {
    "@slidev/client": "catalog:slidev",
    "slidev-theme-personal": "workspace:*"
  },
  "devDependencies": {
    "@slidev/cli": "catalog:build",
    "typescript": "catalog:build"
  }
}
