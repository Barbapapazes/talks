{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r run --workspace-concurrency=-1 build && pnpm run generate:redirects && pnpm run generate:meta",
    "export": "pnpm -r run --workspace-concurrency=1 export",
    "thumbnail": "pnpm -r --workspace-concurrency=1 run thumbnail",
    "thumbnail:dark": "pnpm -r --workspace-concurrency=1 run thumbnail:dark",
    "thumbnail:cp": "pnpm -r --workspace-concurrency=-1 run thumbnail:cp",
    "thumbnail:cp:dark": "pnpm -r --workspace-concurrency=-1 run thumbnail:cp:dark",
    "generate:thumbnails": "node .scripts/generate-thumbnails.ts",
    "optimize:thumbnails": "node .scripts/optimize-thumbnails.ts",
    "ready": "node .scripts/ready-deck.ts && pnpm run generate:readme && pnpm run generate:talk-readme",
    "clean": "rm -rf dist && rm -rf slides-export",
    "generate:redirects": "node .scripts/generate-redirects.ts",
    "generate:meta": "node .scripts/generate-meta.ts",
    "generate:readme": "node .scripts/generate-readme.ts",
    "generate:talk-readme": "node .scripts/generate-talk-readme.ts",
    "generate:tree": "node .scripts/generate-tree.ts",
    "update:timing": "node .scripts/update-timing.ts",
    "sort:frontmatter": "node .scripts/sort-slides-frontmatter.ts",
    "typecheck": "tsc -p tsconfig.node.json && pnpm --filter @soubiran/talks run test:types",
    "release": "bumpp --sign -r",
    "dev": "node .scripts/select-deck.ts dev --open",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "vue": "catalog:test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@iconify-json/devicon": "catalog:icons",
    "@iconify-json/heroicons": "catalog:icons",
    "@iconify-json/logos": "catalog:icons",
    "@iconify-json/lucide": "catalog:icons",
    "@iconify-json/mdi": "catalog:icons",
    "@iconify-json/noto": "catalog:icons",
    "@iconify-json/ph": "catalog:icons",
    "@iconify-json/simple-icons": "catalog:icons",
    "@iconify-json/unjs": "catalog:icons",
    "@iconify-json/vscode-icons": "catalog:icons",
    "@mermaid-js/mermaid-cli": "catalog:scripts",
    "@slidev/cli": "catalog:build",
    "@slidev/parser": "catalog:scripts",
    "@slidev/theme-default": "catalog:slidev",
    "@soubiran/talks": "workspace:*",
    "@types/node": "catalog:build",
    "@types/prompts": "catalog:scripts",
    "@unocss/eslint-plugin": "catalog:lint",
    "bumpp": "catalog:release",
    "changelogithub": "catalog:release",
    "dotenv": "catalog:scripts",
    "eslint": "catalog:lint",
    "execa": "catalog:scripts",
    "fdir": "catalog:scripts",
    "gray-matter": "catalog:scripts",
    "markdown-it": "catalog:scripts",
    "ofetch": "catalog:scripts",
    "openai": "catalog:scripts",
    "pathe": "catalog:scripts",
    "playwright-chromium": "catalog:scripts",
    "prompts": "catalog:scripts",
    "taze": "catalog:scripts",
    "tiktoken": "catalog:scripts",
    "typescript": "catalog:build",
    "unocss": "catalog:build",
    "vitest": "catalog:test",
    "zod": "catalog:scripts"
  }
}
