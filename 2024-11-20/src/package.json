{
  "name": "takimeet",
  "event": {
    "name": "TakiMeet",
    "url": "https://www.takima.fr/",
    "location": {
      "city": "Paris",
      "country": "France",
      "latitude": 48.80486167446941,
      "longitude": 2.324595137047259
    }
  },
  "private": true,
  "description": "Concevez des retours d'interface fluides et fiables en choisissant entre loaders, optimistic UI et skeleton fallbacks, avec une mise en pratique dans Vue et Pinia Colada.",
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /2024-11-20/takimeet/ --out ../../dist/2024-11-20/takimeet",
    "export": "slidev export --per-slide --output ../2024-11-20-takimeet.pdf",
    "thumbnail:cp": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail.png",
    "thumbnail": "slidev export --per-slide --range 1 --format png",
    "thumbnail:dark": "slidev export --per-slide --range 1 --dark --format png",
    "thumbnail:cp:dark": "ffmpeg -y -i slides-export/01.png -vf scale=-1:720 -compression_level 100 ./public/thumbnail-dark.png",
    "optimize:thumbnails": "optipng -o2 -quiet ./public/thumbnail*.png"
  },
  "dependencies": {
    "@slidev/client": "catalog:slidev",
    "seedrandom": "catalog:ui",
    "slidev-addon-inalia": "catalog:slidev"
  },
  "devDependencies": {
    "@slidev/cli": "catalog:build",
    "vite": "catalog:build"
  }
}
